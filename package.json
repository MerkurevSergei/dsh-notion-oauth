{
  "name": "dsh-notion-oauth",
  "version": "0.1.3",
  "description": "Notion integration for DeepSeek Harness via the official Notion MCP (OAuth 2.0 + PKCE) with a GUI login page and a CLI `dsh notion login` fallback. · DSH 的 Notion 集成插件（OAuth 2.0 + PKCE），支持 GUI 一键登录与命令行授权。",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" }
  },
  "dependencies": { "commander": "^15.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-cmdline": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["dsh", "dsh-plugin", "notion", "mcp", "oauth", "deepseek-harness"]
}


