{
  "name": "dsh-notion-oauth",
  "version": "1.0.0",
  "description": "Connect Notion through the official Notion MCP with OAuth 2.0 and PKCE — GUI sign-in, no integration token required.",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "Merkurev Sergei <merkurevsn@gmail.com> (https://github.com/MerkurevSergei)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerkurevSergei/dsh-notion-oauth.git"
  },
  "homepage": "https://github.com/MerkurevSergei/dsh-notion-oauth#readme",
  "bugs": { "url": "https://github.com/MerkurevSergei/dsh-notion-oauth/issues" },
  "engines": { "node": ">=22.12.0", "dsh": ">=0.1.5-rc.3" },
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "README.zh.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" }
  },
  "dependencies": { "commander": "^15.0.0" },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["dsh", "dsh-plugin", "notion", "mcp", "oauth", "deepseek-harness"]
}





















